# En Vite TODA variable visible en el código debe empezar por VITE_
# Se lee con: import.meta.env.VITE_API_URL
# Si cambias este archivo hay que reiniciar "npm run dev".
#
# OJO con el modo: este archivo se carga en TODOS los modos. Lo que vale para
# producción está en `.env.production` (sí se commitea) y tiene prioridad sobre
# este en `npm run build`.

# URL del backend (sin barra final).
# Es OPCIONAL: `vite.config.js` ya proxya `/api` hacia http://localhost:3000,
# así que el dev funciona sin definir nada. Se usa solo si el backend corre en
# otro host/puerto distinto de localhost:3000.
# VITE_API_URL=http://localhost:3000/api

# Título de la aplicación (router.afterEach lo pone en la pestaña).
VITE_APP_TITULO=LABFICAT
