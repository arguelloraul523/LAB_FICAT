# En Vite TODA variable visible en el código debe empezar por VITE_
# Se lee con: import.meta.env.VITE_API_URL
# Si cambias este archivo hay que reiniciar "npm run dev".

# URL del backend (sin barra final).
VITE_API_URL=http://localhost:3000/api

# Título de la aplicación (router.afterEach lo pone en la pestaña).
VITE_APP_TITULO=LABFICAT
